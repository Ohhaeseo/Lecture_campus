# 이 파일을 복사해서 .env.local 로 저장한 뒤 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# Supabase 대시보드 > Project Settings > API Keys (또는 상단 Connect 버튼)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 새 프로젝트는 publishable key(sb_publishable_...), 예전 프로젝트는 anon key 를 넣으면 됩니다
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Anthropic Console (https://console.anthropic.com) > API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# (선택) 사용할 Claude 모델. 기본값 claude-opus-5
# 비용을 줄이려면 claude-sonnet-5 등으로 바꿀 수 있어요
# ANTHROPIC_MODEL=claude-opus-5

# (선택) 아이디를 Supabase 내부 이메일로 바꿀 때 쓰는 도메인. 기본값 users.localtest.me
# 가입자가 생긴 뒤에 바꾸면 기존 계정으로 로그인할 수 없으니 처음에 정하고 바꾸지 마세요
# AUTH_EMAIL_DOMAIN=users.localtest.me

# Deepgram Console (https://console.deepgram.com) > API Keys
# 강의 녹음 받아쓰기에 사용합니다. 가입 시 $200 크레딧(카드 등록 불필요)
DEEPGRAM_API_KEY=
